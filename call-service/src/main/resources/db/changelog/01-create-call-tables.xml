<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

    <changeSet id="01-create-call-tables" author="system">
        <comment>Create call_logs and call_attempts tables</comment>

        <!-- Create call_logs table -->
        <createTable tableName="call_logs">
            <column name="call_id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="patient_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="schedule_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="call_status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="ivr_response" type="VARCHAR(255)"/>
            <column name="call_duration_seconds" type="INT"/>
            <column name="response_received" type="BOOLEAN" defaultValue="false">
                <constraints nullable="false"/>
            </column>
            <column name="attempt_notes" type="VARCHAR(255)"/>
            <column name="call_initiated_at" type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
            <column name="call_answered_at" type="TIMESTAMP"/>
            <column name="call_ended_at" type="TIMESTAMP"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Create call_attempts table -->
        <createTable tableName="call_attempts">
            <column name="attempt_id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="call_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="attempt_number" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="response_code" type="VARCHAR(50)"/>
            <column name="retry_count" type="INT" defaultValue="0">
                <constraints nullable="false"/>
            </column>
            <column name="attempted_at" type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
            <column name="responded_at" type="TIMESTAMP"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Create indexes -->
        <createIndex tableName="call_logs" indexName="idx_call_logs_patient_id">
            <column name="patient_id"/>
        </createIndex>
        <createIndex tableName="call_logs" indexName="idx_call_logs_schedule_id">
            <column name="schedule_id"/>
        </createIndex>
        <createIndex tableName="call_logs" indexName="idx_call_logs_call_status">
            <column name="call_status"/>
        </createIndex>

        <createIndex tableName="call_attempts" indexName="idx_call_attempts_call_id">
            <column name="call_id"/>
        </createIndex>
        <createIndex tableName="call_attempts" indexName="idx_call_attempts_attempt_number">
            <column name="attempt_number"/>
        </createIndex>

        <!-- Add foreign key constraints -->
        <addForeignKeyConstraint baseTableName="call_attempts"
                                 baseColumnNames="call_id"
                                 constraintName="fk_call_attempts_call"
                                 referencedTableName="call_logs"
                                 referencedColumnNames="call_id"
                                 onDelete="CASCADE"/>

        <!-- Standard SQL Check Constraints -->
        <sql>
            ALTER TABLE call_logs 
            ADD CONSTRAINT chk_call_logs_status 
            CHECK (call_status IN ('INITIATED', 'IN_PROGRESS', 'COMPLETED', 'FAILED'));
        </sql>

        <sql>
            ALTER TABLE call_attempts 
            ADD CONSTRAINT chk_call_attempts_status 
            CHECK (status IN ('PENDING', 'SUCCESS', 'FAILED'));
        </sql>

    </changeSet>
</databaseChangeLog>