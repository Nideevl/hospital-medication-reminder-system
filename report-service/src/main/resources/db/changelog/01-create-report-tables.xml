<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

    <changeSet id="01-create-report-tables" author="system">
        <comment>Create medication_reports and compliance_data tables</comment>

        <!-- Create medication_reports table -->
        <createTable tableName="medication_reports">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="report_id" type="UUID"/>
            <column name="patient_id" type="UUID"/>
            <column name="hospital_id" type="VARCHAR(100)"/>
            <column name="report_type" type="VARCHAR(50)"/>
            <column name="report_date" type="DATE"/>
            <column name="start_date" type="DATE"/>
            <column name="end_date" type="DATE"/>
            <column name="total_medications_scheduled" type="INT" defaultValueNumeric="0"/>
            <column name="total_scheduled" type="INT" defaultValueNumeric="0"/>
            <column name="medications_taken" type="INT" defaultValueNumeric="0"/>
            <column name="total_taken" type="INT" defaultValueNumeric="0"/>
            <column name="medications_missed" type="INT" defaultValueNumeric="0"/>
            <column name="total_missed" type="INT" defaultValueNumeric="0"/>
            <column name="adherence_percentage" type="DOUBLE" defaultValueNumeric="0.0"/>
            <column name="compliance_percentage" type="DECIMAL(5,2)"/>
            <column name="report_status" type="VARCHAR(50)"/>
            <column name="generated_by" type="VARCHAR(100)"/>
            <column name="summary" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="NOW()"/>
            <column name="generated_at" type="TIMESTAMP"/>
        </createTable>

        <!-- Create compliance_data table -->
        <createTable tableName="compliance_data">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="patient_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="week_number" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="month" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="adherence_score" type="DOUBLE">
                <constraints nullable="false"/>
            </column>
            <column name="missed_doses" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="escalations_triggered" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="notes" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Create indexes -->
        <createIndex tableName="medication_reports" indexName="idx_medication_reports_patient_id">
            <column name="patient_id"/>
        </createIndex>
        <createIndex tableName="medication_reports" indexName="idx_medication_reports_hospital_id">
            <column name="hospital_id"/>
        </createIndex>
        <createIndex tableName="medication_reports" indexName="idx_medication_reports_report_date">
            <column name="report_date"/>
        </createIndex>

        <createIndex tableName="compliance_data" indexName="idx_compliance_data_patient_id">
            <column name="patient_id"/>
        </createIndex>
        <createIndex tableName="compliance_data" indexName="idx_compliance_data_month">
            <column name="month"/>
        </createIndex>

        <!-- Add CHECK constraints using raw SQL -->
        <sql>
            ALTER TABLE medication_reports 
            ADD CONSTRAINT chk_medication_reports_adherence 
            CHECK (adherence_percentage BETWEEN 0 AND 100);
        </sql>

        <sql>
            ALTER TABLE compliance_data 
            ADD CONSTRAINT chk_compliance_data_score 
            CHECK (adherence_score BETWEEN 0 AND 100);
        </sql>

        <sql>
            ALTER TABLE compliance_data 
            ADD CONSTRAINT chk_compliance_data_week 
            CHECK (week_number BETWEEN 1 AND 53);
        </sql>

    </changeSet>
</databaseChangeLog>