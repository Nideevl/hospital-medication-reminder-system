<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

    <changeSet id="01-create-audit-tables" author="system">
        <comment>Create medication_audits and user_actions tables</comment>

        <!-- Create medication_audits table -->
        <createTable tableName="medication_audits">
            <column name="audit_id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="patient_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="schedule_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="medication_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="action" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="scheduled_time" type="TIMESTAMP"/>
            <column name="actual_time" type="TIMESTAMP"/>
            <column name="delay_minutes" type="BIGINT"/>
            <column name="notes" type="TEXT"/>
            <column name="recorded_by" type="VARCHAR(100)"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Create user_actions table -->
        <createTable tableName="user_actions">
            <column name="action_id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="action_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="entity" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="entity_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="change_details" type="TEXT"/>
            <column name="ip_address" type="VARCHAR(45)"/>
            <column name="user_agent" type="VARCHAR(255)"/>
            <column name="timestamp" type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Create indexes -->
        <createIndex tableName="medication_audits" indexName="idx_medication_audits_patient_id">
            <column name="patient_id"/>
        </createIndex>
        <createIndex tableName="medication_audits" indexName="idx_medication_audits_created_at">
            <column name="created_at"/>
        </createIndex>

        <createIndex tableName="user_actions" indexName="idx_user_actions_user_id">
            <column name="user_id"/>
        </createIndex>
        <createIndex tableName="user_actions" indexName="idx_user_actions_action_type">
            <column name="action_type"/>
        </createIndex>

        <!-- Check Constraints using standard SQL -->
        <sql>
            ALTER TABLE medication_audits 
            ADD CONSTRAINT chk_medication_audits_action 
            CHECK (action IN ('CREATED', 'UPDATED', 'DELETED', 'TAKEN', 'MISSED'));
        </sql>

        <sql>
            ALTER TABLE user_actions 
            ADD CONSTRAINT chk_user_actions_action 
            CHECK (action_type IN ('LOGIN', 'SCHEDULE_CREATED', 'ESCALATION_TRIGGERED', 'REPORT_GENERATED'));
        </sql>

    </changeSet>
</databaseChangeLog>